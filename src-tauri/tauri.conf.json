{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WavePen",
  "version": "1.0.0",
  "identifier": "com.wavepen.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "WavePen",
        "width": 900,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "visible": false
      },
      {
        "label": "capsule",
        "title": "WavePen Capsule",
        "width": 80,
        "height": 80,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "url": "index.html#capsule"
      },
      {
        "label": "ask",
        "title": "WavePen Ask",
        "width": 400,
        "height": 220,
        "minWidth": 360,
        "minHeight": 180,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "url": "index.html#ask"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "wavepen"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist",
      "signingIdentity": "-",
      "files": {
        "Resources/zh-Hant.lproj/InfoPlist.strings": "./macos/zh-Hant.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "./macos/en.lproj/InfoPlist.strings"
      }
    },
    "linux": {
      "appimage": {
        "files": {
          ".DirIcon": "icons/icon.png"
        }
      }
    }
  },
  "mainBinaryName": "WavePen"
}
